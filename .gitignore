# Runtime data, caches and distributable output (root-relative).
/data/
/publish/
/temp/*
!/temp/.gitkeep
/artifacts/
/backups/
/coverage/
/docs/local/
/reports/

# Private development documentation; dependency license texts are distributable.
/docs/*
!/docs/licenses/

# Machine-specific configuration. Track didanihaa.example.json instead.
/didanihaa.json
/didanihaa.local.json
/didanihaa.json.*.tmp
.env
.env.*
!.env.example
!.env.sample
**/appsettings.Local.json
**/appsettings.*.local.json
/secrets/
/.aws/
/.codex/

# Media catalogs may contain private file names even outside the default data folder.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.bak

# .NET and frontend build products; lock files remain versioned.
**/bin/
**/obj/
**/node_modules/
/src/Didanihaa.WebUI/dist/
**/TestResults/
*.trx
*.coverage
*.coveragexml
*.log
*.dmp

# Local IDE / operating-system state.
.vs/
.idea/
.vscode/
.history/
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
Desktop.ini

# Private certificate/key material and locally supplied executable tools.
*.pfx
*.p12
*.key
*.pem
*.keystore
*.jks
/tools/*.exe
/tools/*.dll

# Local media and copied distribution archives do not belong in source control.
*.mp4
*.m4v
*.mkv
*.webm
*.avi
*.mov
*.mpg
*.mpeg
*.wmv
*.3gp
*.vob
*.m2ts
*.mts
*.mp3
*.m4a
*.aac
*.flac
*.wav
*.ogg
*.opus
*.wma
*.aif
*.aiff
*.zip
*.7z
*.rar
*.nupkg
*.exe
*.dll
*.pdb
*.msi

# Local agent configuration and workspace instructions.
/.agents/*
/AGENTS.md
